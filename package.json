{
  "name": "yellow-skipper-games-merch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pages:dev": "pnpm run build && wrangler pages dev --live-reload",
    "build": "vite build",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"functions/**/*.js\" \"*.{html,json,js,cjs,md}\" \"public/**/*.{html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"functions/**/*.js\" \"*.{html,json,js,cjs,md}\" \"public/**/*.{html,json}\"",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && react-doctor --verbose"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.62.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react-doctor": "^0.8.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.153.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,css,md}": "prettier --write",
    "functions/**/*.js": "prettier --write",
    "*.{html,json,js,cjs,md}": "prettier --write",
    "public/**/*.{html,json}": "prettier --write"
  },
  "packageManager": "pnpm@12.14.0"
}
